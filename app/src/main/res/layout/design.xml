<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/layout_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:fitsSystemWindows="true"
                app:elevation="0dp"
                app:liftOnScroll="false">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    app:contentInsetEnd="4dp"
                    app:contentInsetEndWithActions="4dp"
                    app:contentInsetStart="4dp"
                    app:contentInsetStartWithNavigation="4dp"
                    app:navigationIcon="@null"
                    app:title=""
                    tools:menu="@menu/design_menu">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/workspace_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="start|center_vertical"
                        app:checkedButton="@id/tab_java"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tab_java"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/design_tab_title_java"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tab_ui"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/design_tab_title_ui"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tab_event"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/design_tab_title_event"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tab_component"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/design_tab_title_component"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </com.google.android.material.appbar.MaterialToolbar>

                <LinearLayout
                    android:id="@+id/file_name_container"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/file_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="main" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_drop_down_24px"
                            app:tint="?attr/colorControlNormal"
                            tools:ignore="ContentDescription" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="?attr/colorOutlineVariant" />

                    <pro.sketchware.activities.design.DesignHistoryButton
                        android:id="@+id/design_undo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/design_tools_undo"
                        android:padding="12dp"
                        android:src="@drawable/ic_mtrl_undo"
                        android:tag="undo"
                        app:tint="?attr/colorControlNormal" />

                    <pro.sketchware.activities.design.DesignHistoryButton
                        android:id="@+id/design_redo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/design_tools_redo"
                        android:padding="12dp"
                        android:src="@drawable/ic_mtrl_redo"
                        android:tag="redo"
                        app:tint="?attr/colorControlNormal" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="?attr/colorSurfaceContainerHighest" />
            </com.google.android.material.appbar.AppBarLayout>

            <FrameLayout
                android:id="@+id/layout_coordinator"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/editor_fragment_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/fab_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/fab_run"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/design_run"
                        android:visibility="gone"
                        app:icon="@drawable/ic_mtrl_run"
                        tools:visibility="visible" />

                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/fab_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/design_fab_more"
                        android:visibility="gone"
                        app:icon="@drawable/ic_mtrl_more_vertical"
                        tools:visibility="visible" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/design_fab_actions"
                        app:srcCompat="@drawable/ic_mtrl_add" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="?attr/colorSurfaceContainerHighest" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/progress_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="Java is compiling..." />

                    <TextView
                        android:id="@+id/progress_step_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="13/20 · 0:12" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="2dp"
                    android:indeterminate="false"
                    android:progress="0"
                    app:trackStopIndicatorSize="0dp" />
            </LinearLayout>
        </LinearLayout>

        <pro.sketchware.activities.editor.view.ViewProperty
            android:id="@+id/view_property"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="bottom"
            android:translationY="170dp" />
    </FrameLayout>

    <pro.sketchware.activities.design.DesignDrawer
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end" />
</androidx.drawerlayout.widget.DrawerLayout>
