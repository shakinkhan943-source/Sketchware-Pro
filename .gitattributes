# Auto detect text files and perform LF normalization
* text=auto
.zip filter=lfs diff=lfs merge=lfs -text

# Never apply EOL normalization to native binaries. The bundled AAPT2
# executables are ELF files; a CRLF/LF rewrite on checkout (notably on Windows)
# corrupts them and makes builds fail at the AAPT2 step.
*.so binary
*.jar binary
*.aar binary
*.keystore binary
